# ============================================================================
#  Biz Forecaster 설정 예시
#
#  [쓰는 법]
#   1) 프로젝트 폴더 안에 .streamlit 폴더를 만듭니다. (없으면 직접 생성)
#   2) 이 파일을 그 안에 복사하고 이름을 secrets.toml 로 바꿉니다.
#   3) 아래 값을 채워 넣습니다.
#
#   최종 위치:  .streamlit/secrets.toml   ← 앱은 이 경로만 읽습니다.
#   프로젝트 루트에 secrets.toml 을 두면 인식되지 않습니다.
#
#  설정하지 않아도 앱은 개발 모드로 정상 동작합니다.
#  (메일을 보내는 대신 인증코드를 화면에 바로 표시)
#
#  .streamlit/secrets.toml 은 .gitignore 에 등록되어 있어 깃에 올라가지
#  않습니다. 실제 키를 이 example 파일에 적지 마세요.
# ============================================================================

# ---------------------------------------------------------------------------
# 1. 이메일 인증코드 발송  (회원가입 / 비밀번호 찾기)
# ---------------------------------------------------------------------------
# 설정하지 않으면 개발 모드로 동작합니다.
# 메일을 보내지 않고 인증코드를 화면에 바로 띄우므로, 설정 없이도 가입 흐름을
# 그대로 시험해볼 수 있습니다.
#
# provider 는 "naver" 또는 "gmail" 중 하나입니다.
#
#  [네이버]
#   1) 네이버 메일 > 환경설정 > POP3/IMAP 설정 > "IMAP/SMTP 사용" 을 켭니다.
#   2) 2단계 인증을 쓰는 계정이라면 네이버 계정관리에서
#      애플리케이션 비밀번호를 발급받아 password 에 넣습니다.
#
#  [구글 / Gmail]
#   1) Google 계정 > 보안 > 2단계 인증을 켭니다.
#   2) 같은 화면에서 "앱 비밀번호"(16자리)를 생성해 password 에 넣습니다.
#   ※ 일반 로그인 비밀번호로는 SMTP 접속이 거부됩니다.

[email]
provider    = "gmail"                    # "gmail" 또는 "naver"
sender      = "본인주소@gmail.com"        # 보내는 사람 = 앱 비밀번호를 발급받은 계정
password    = ""                         # ← 앱 비밀번호 16자리를 여기에
sender_name = "Biz Forecaster"

# ---------------------------------------------------------------------------
# 2. LLM 기능  (AI 브리핑 / What-if 채팅)
# ---------------------------------------------------------------------------
# 없어도 예측·이상탐지·SHAP 기능은 모두 정상 동작합니다.
# 이 키가 없으면 AI 브리핑과 What-if 채팅만 비활성화됩니다.

# OPENAI_API_KEY = "sk-..."

# (선택) LangSmith 추적 — 에이전트 호출 이력을 웹에서 보고 싶을 때만
# LANGSMITH_API_KEY = "ls__..."
# LANGSMITH_TRACING = "true"
# LANGSMITH_PROJECT = "biz-forecaster"


# ---------------------------------------------------------------------------
# 3. 배포할 때 — 이 파일은 깃에 올라가지 않습니다
# ---------------------------------------------------------------------------
# secrets.toml 은 .gitignore 에 등록돼 있어 저장소에 포함되지 않습니다.
# 배포된 앱은 아래 방법으로 같은 설정을 받습니다.
#
#  [Streamlit Community Cloud]
#    앱 설정 화면의 "Secrets" 입력란에 위 [email] 블록을 그대로 붙여넣습니다.
#    플랫폼이 실행 시점에 주입해주므로 코드는 손댈 필요가 없습니다.
#
#  [Docker / Render / Railway / 회사 서버]
#    Secrets 입력란이 없으므로 환경변수를 사용합니다.
#      BIZ_EMAIL_PROVIDER=gmail
#      BIZ_EMAIL_SENDER=myshop@gmail.com
#      BIZ_EMAIL_PASSWORD=앱비밀번호16자리
#      BIZ_EMAIL_SENDER_NAME=Biz Forecaster
#
#  셋 중 아무것도 없으면 개발 모드로 동작합니다(인증코드를 화면에 표시).
#  어느 경로로 읽혔는지는 check_email.py 가 "설정 출처" 줄에 알려줍니다.
